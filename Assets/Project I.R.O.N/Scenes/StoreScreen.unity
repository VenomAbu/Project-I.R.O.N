    sentence: Amira observa a equipe se aproximar.
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Amira
    portrait: {fileID: 3730332489590165390, guid: 1aa0b2751b2006044b139d2b5e531eac, type: 3}
    sentence: "Ainda est\xE3o aqui."
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Irina
    portrait: {fileID: 4392531664169837997, guid: 96ea4d056193b7944b48a605945010ed, type: 3}
    sentence: Parece decepcionada.
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Amira
    portrait: {fileID: 3730332489590165390, guid: 1aa0b2751b2006044b139d2b5e531eac, type: 3}
    sentence: "S\xF3 surpresa."
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: 
    portrait: {fileID: -799903641346810218, guid: 0a80e5ed52466cc438f25498671ea6b6, type: 3}
    sentence: "Haruto observa os moradores refor\xE7ando barricadas."
    cameraDaFala: {fileID: 0}
    choices:
    - textDaEscolha: "A situa\xE7\xE3o parece pior do que imaginei"
      proximoNodeId: IntroEmpatico
    - textDaEscolha: "Quanto tempo voc\xEAs conseguem resistir?"
      proximoNodeId: IntroMilitar
    - textDaEscolha: "J\xE1 pensaram em abandonar a cidade?"
      proximoNodeId: IntroPragmatico
  - nodeId: IntroEmpatico
    characterName: Haruto
    portrait: {fileID: -799903641346810218, guid: 0a80e5ed52466cc438f25498671ea6b6, type: 3}
    sentence: "A situa\xE7\xE3o parece pior do que imaginei."
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Amira
    portrait: {fileID: 3730332489590165390, guid: 1aa0b2751b2006044b139d2b5e531eac, type: 3}
    sentence: "Isso porque voc\xEA chegou em um dia bom."
    cameraDaFala: {fileID: 0}
    choices:
    - textDaEscolha: Continuar
      proximoNodeId: Hub
  - nodeId: IntroMilitar
    characterName: Haruto
    portrait: {fileID: -799903641346810218, guid: 0a80e5ed52466cc438f25498671ea6b6, type: 3}
    sentence: "Quanto tempo voc\xEAs conseguem resistir?"
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Amira
    portrait: {fileID: 3730332489590165390, guid: 1aa0b2751b2006044b139d2b5e531eac, type: 3}
    sentence: "Finalmente algu\xE9m fazendo a pergunta certa."
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: 
    portrait: {fileID: -2054692389715966358, guid: 8064c080da4267544bfe8f4226555966, type: 3}
    sentence: Daniel aprova com um leve aceno.
    cameraDaFala: {fileID: 0}
    choices:
    - textDaEscolha: Continuar
