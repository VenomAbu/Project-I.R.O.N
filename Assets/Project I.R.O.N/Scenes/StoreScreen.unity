    choices: []
  - nodeId: 
    characterName: Daniel
    portrait: {fileID: -2054692389715966358, guid: 8064c080da4267544bfe8f4226555966, type: 3}
    sentence: "Poucas rotas de retirada, pouca muni\xE7\xE3o, muros ruins..."
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Irina
    portrait: {fileID: 4392531664169837997, guid: 96ea4d056193b7944b48a605945010ed, type: 3}
    sentence: "Voc\xEA consegue olhar para qualquer lugar sem criar um relat\xF3rio
