  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  autoStart: 1
  startNodeId: 
  dialoguePanel: {fileID: 1853555447}
  portraitImage: {fileID: 1938645115}
  nameText: {fileID: 1751369261}
  dialogueText: {fileID: 1683221295}
  choicesPanel: {fileID: 803396782}
  choiceButtonPrefab: {fileID: 5712742434956154721, guid: 674305b67155c974f86ab90e812a2d6a, type: 3}
  playerCam: {fileID: 450936948}
  hordaFalsa: {fileID: 2095973012}
  lines:
  - nodeId: 
    characterName: Guarda
    portrait: {fileID: -4959718041169702101, guid: 0261049f826031049a82efd8dfb00ea8, type: 3}
    sentence: "Os monstros est\xE3o prestes a invadir a cidade, por favor impe\xE7a
      que eles consigam chegar at\xE9 n\xF3s, nossas for\xE7as de defesa est\xE3o
      inoperantes no momento!"
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: 
    portrait: {fileID: 0}
    sentence: "\u201CHaruto estava pensativo pois seria mais um dia de atraso em
      sua traget\xF3ria, mas ao ver que os sobreviventes naquela cidade estavam largados
      a pr\xF3pria sorte resolve ajudar.\u201D"
    cameraDaFala: {fileID: 691922487}
    choices: []
  - nodeId: 
    characterName: Haruto
    portrait: {fileID: -799903641346810218, guid: 0a80e5ed52466cc438f25498671ea6b6, type: 3}
    sentence: "Pode deixar com a gente, n\xE3o vamos deixar eles passarem, Irina,
      Daniel, vamos l\xE1!"
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Irina
    portrait: {fileID: 4392531664169837997, guid: 96ea4d056193b7944b48a605945010ed, type: 3}
    sentence: Pisando fundo!
    cameraDaFala: {fileID: 0}
    choices: []
  - nodeId: 
    characterName: Daniel
    portrait: {fileID: -2054692389715966358, guid: 8064c080da4267544bfe8f4226555966, type: 3}
    sentence: Alvos na mira!
    cameraDaFala: {fileID: 0}
    choices: []
